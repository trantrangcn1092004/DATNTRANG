<!DOCTYPE html>
<html lang="vi">

<head>
	<meta charset="UTF-8">
	<meta name="theme-color" content="#2a7ee4">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta name="author" content="DO GIA DUNG TOAN HIEN">
	<meta name="description" content="Chào mừng bạn đến với Đồ gia dụng Toản Hiền – nơi cung cấp các sản phẩm tiện ích cho gia đình như nồi cơm điện, máy xay, quạt và nhiều thiết bị hữu ích khác.
Chúng tôi cam kết mang đến chất lượng tốt – giá hợp lý – phục vụ tận tâm.">
	<link rel="shortcut icon" type="image/x-icon" href="/imgs/thiet-ke-logo-do-gia-dung-hc.png">
	<link rel="stylesheet" href="/styles/admin/pages/login_admin.css">

	<title>TOẢN HIỀN.Admin - Đăng nhập</title>
</head>

<body>
	<main>
		<div class="login__box">
			<div class="login__inner-box">
				<div class="login__forms-wrap">
					<form id="form" autocomplete="off" class="login__sign-in-form">
						<div class="login__logo">
							<a href=#><img src="/imgs/admin//logotoanhienxanh_admin.png" alt="toanhien"> </a>
						</div>

						<div class="login__heading">
							<h1>Chào mừng quay trở lại Admin TOẢN HIỀN</h1>
						</div>

						<div class="actual-form">
							<div class="login__input-wrap">
								<input id="adminLogin" type="text" name="adminLogin" class="login__input-field" autocomplete="off">
								<label>Tên đăng nhập<span class="red-start">*</span></label>
								<div class="login__error"></div>
							</div>

							<div class="login__input-wrap">
								<input id="password" type="password" name="password" class="login__input-field" autocomplete="off">
								<label>Mật khẩu<span class="red-start">*</span></label>
								<span id="togglePassword" class="login__toggle-password"><span class="material-symbols-outlined eye-open">
										visibility</span>
								</span>
								<div class="login__error"></div>
							</div>

							<input type="submit" value="Đăng nhập" class="login__sign-btn">
							<!-- <input value="Đăng nhập" class="login__sign-btn" > -->
							<p class="login__text">
								<a href="#">Quên mật khẩu?</a>
							</p>
						</div>
					</form>
				</div>
			</div>
		</div>
	</main>
	<script src="/scripts/admin/login_admin.js"></script>

</body>

</html>