<!DOCTYPE html>
<html lang="vi">

<head>
	<meta charset="UTF-8" />
	<meta name="theme-color" content="#2a7ee4">
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<meta name="description" content="Chào mừng bạn đến với Đồ gia dụng Toản Hiền – nơi cung cấp các sản phẩm tiện ích cho gia đình như nồi cơm điện, máy xay, quạt và nhiều thiết bị hữu ích khác.
Chúng tôi cam kết mang đến chất lượng tốt – giá hợp lý – phục vụ tận tâm.">
	<link rel="shortcut icon" type="image/x-icon" href="/imgs/thiet-ke-logo-do-gia-dung-hc.png">
	<link rel="stylesheet" href="/styles/pages/notification/order.css" />

	<title>TOẢN HIỀN.</title>
</head>

<body>
	<%- include('../../partials/header', { header: header }) %>
	<%- include('../../partials/breadcrumb', { breadcrumbs : [{ text : 'Thông báo', link : '' }, { text : 'Cập nhật tài khoản', link : '' }] }) %>

	<main class="nofi-container">
		<aside class="aside-wrapper">
			<div class="aside-wrapper__aside-info">
				<img class="aside-wrapper__aside-avatar" src="/imgs/user_avt_img/<%= (user.user.user_avt_img) ? user.user.user_avt_img : 'default.png' %>" alt="avatar" />
				<div class="aside-wrapper__aside-title">
					<p>Thông báo</p>
				</div>
			</div>
			<hr />
			<div class="aside-wrapper__aside-section">
				<a href="/notification/order" class="btn-update">Cập nhật đơn hàng</a>
				<a href="/notification/promotion" class="btn-promo">Thông tin khuyến mãi</a>
			</div>
		</aside>

		<section class="nofi__main">
			<div class="nofi--disable">
				<div class="noti__button-update--disable">
					<a href="/notification/order" class="btn-update--disable">Cập nhật đơn hàng</a>
					<hr />
				</div>
				<div class="noti__button-promo--disable">
					<a href="/notification/promotion" class="btn-promo--disable">Thông tin khuyến mãi</a>
					<hr />
				</div>
			</div>
			<div class="btn-mark-all-read">
				<input type="hidden" name="noti-length" value="<%= order.length %>">
				<span>Đánh dấu tất cả là đã đọc (<%= order.length %>)</span>
			</div>
			<% for(let i = 0; i < order.length; i++) {%>
			<%- include('../../components/noti-item-order', { noti: order[i], index: i, toDDMMYYYY: formatFunction.toDDMMYYYY, toHHMM: formatFunction.toHHMM }) %>
			<% } %>

		</section>
	</main>

	<%- include('../../components/scrollup') %>
	<%- include('../../partials/footer') %>
	<%- include('../../partials/app-bar') %>

	<script src="/scripts/components/scrollup.js"></script>
	<script src="/scripts/pages/notification/order.js"></script>

</body>

</html>